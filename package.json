{
  "name": "@gsbio/engine",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "import": "./dist/remote/index.js",
      "require": "./dist/remote/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:integration": "node test_pmtiles_engine.mjs",
    "build:example": "npm run build --prefix examples/demo-web",
    "dev:example": "npm run dev --prefix examples/demo-web",
    "build:all": "npm run build && npm run build:example",
    "test:all": "npm run test && npm run build:example"
  },
  "dependencies": {
    "@ngageoint/geopackage": "^4.2.9",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^6.12.0",
    "pmtiles": "^4.5.0",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terra-draw": "^1.36.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
