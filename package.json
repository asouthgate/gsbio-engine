{
  "name": "@gsbio/engine",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint src/",
    "test": "vitest run",
    "build:example": "npm run build --prefix examples/demo-web",
    "dev:example": "npm run dev --prefix examples/demo-web",
    "build:all": "npm run build && npm run build:example",
    "test:all": "npm run test && npm run build:example"
  },
  "dependencies": {
    "maplibre-gl": "^4.0.0",
    "pmtiles": "^4.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "terra-draw": "^1.0.0",
    "terra-draw-maplibre-gl-adapter": "^1.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^24.1.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  }
}
