{
  "name": "@catshark/react-ui",
  "version": "0.0.1",
  "description": "Headless presentational React components for @catshark/core: renderer-agnostic UI scaffolding for the draw → configure → run workflow. No simulation logic, no rendering backend, no shipped CSS.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@catshark/core": "workspace:*",
    "@catshark/react": "workspace:*"
  },
  "dependencies": {
    "@catshark/core": "workspace:*",
    "@catshark/react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}